# SozuPay Dashboard – environment variables
# Copy to .env.local and fill in values. See docs/runbooks.md.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SDP-compatible wallet (SEP-10 client_domain + SEP-24 recipient flow)
# Comma-separated SDP hostnames allowed when fetching /.well-known/stellar.toml (SSRF guard).
# SDP_ALLOWED_DOMAINS=sdp.example.com,localhost:8000
# Hostname only (no scheme). Must match the Host header SDP uses for client_domain fetches.
# WALLET_CLIENT_DOMAIN=localhost:3000
# Stellar secret key used only for SEP-10 client-domain signatures (publish public via /.well-known/stellar.toml).
# SEP10_CLIENT_SIGNING_SECRET=
# Optional: path segment for signed invite URLs (default /sdp/invite). Must match SDP "Deep link schema" path.
# SDP_INVITE_PATHNAME=/sdp/invite
# Optional: DOCUMENTATION URL in wallet stellar.toml
# WALLET_DOCUMENTATION_URL=https://docs.example.com/wallet

# Supabase (shared DB with recipient wallet; required for dashboard users)
# NEXT_PUBLIC_SUPABASE_URL=   # project URL from Supabase dashboard
# SUPABASE_SERVICE_ROLE_KEY= # service role key (server only; bypasses RLS)

# Org Sozu tag integration (shared tag directory)
# If your `stellar_wallets` table uses different column names, override them here:
# SOZUPAY_STELLAR_WALLET_USER_ID_COLUMN=user_id
# SOZUPAY_STELLAR_WALLET_PUBLIC_KEY_COLUMN=public_key

# Stellar (backend only – never expose secret keys to frontend)
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC (required when org has soroban_contract_id – Phase 2 NGO disbursement)
# SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org  # for production

# OpenZeppelin Smart Accounts (Soroban) — passkey/WebAuthn (secp256r1) signing
# These defaults come from smart-account-kit demo (testnet) and are intended for development only.
# For production, pin the OZ version you’re using and set mainnet addresses/hashes explicitly.
#
# Testnet uploaded WASM hash for Smart Account implementation
# OZ_SMART_ACCOUNT_WASM_HASH_TESTNET=3e51f5b222dec74650f0b33367acb42a41ce497f72639230463070e666abba2c
# Testnet deployed verifier/policy contracts
# OZ_WEBAUTHN_VERIFIER_CONTRACT_ID_TESTNET=CATPTBRWVMH5ZCIKO5HN2F4FMPXVZEXC56RKGHRXCM7EEZGGXK7PICEH
# OZ_THRESHOLD_POLICY_CONTRACT_ID_TESTNET=CDDQLFG7CV74QHWPSP6NZIPNBR2PPCMTUVYCJF4P3ONDYHODRFGR7LWC
#
# Mainnet equivalents (set when ready)
# OZ_SMART_ACCOUNT_WASM_HASH_PUBLIC=
# OZ_WEBAUTHN_VERIFIER_CONTRACT_ID_PUBLIC=
# OZ_THRESHOLD_POLICY_CONTRACT_ID_PUBLIC=

# Org disbursement wallet: holds USDC and signs all payout transactions.
# Super-admin authorizes each payout in the app; this wallet signs on Stellar.
# Order of precedence: ORG_DISBURSEMENT_SECRET > STELLAR_DISBURSEMENT_SECRET > STELLAR_FUNDER_SECRET.
# Create a keypair, fund with Friendbot (testnet), add USDC trustline and get test USDC.
ORG_DISBURSEMENT_SECRET=
# STELLAR_DISBURSEMENT_SECRET=
# STELLAR_FUNDER_SECRET=

# Optional: for funding new user Stellar accounts (createAccount)
# STELLAR_FUNDER_SECRET=

# NEXT_PUBLIC_STELLAR_NETWORK=testnet   # optional; for Stellar Expert links
# STELLAR_NETWORK=public
# HORIZON_URL=https://horizon.stellar.org

# Auth
# AUTH_SECRET=  # used to sign session cookie

# Privy (dashboard login: email, passkey, Google OAuth / Gmail)
# From https://dashboard.privy.io
# PRIVY_APP_ID=           # app id (server can use this)
# PRIVY_APP_SECRET=       # app secret (optional; for Privy server API calls)
# NEXT_PUBLIC_PRIVY_APP_ID=  # same as PRIVY_APP_ID; required for client (Next.js only exposes NEXT_PUBLIC_* to browser)
# PRIVY_VERIFICATION_KEY= # from Dashboard > App settings > Verification key (for server token verification; not the app secret)
# Enable Google (Gmail) in Dashboard > Authentication > Login methods > OAuth. Use default credentials for dev, or add your own in Google Cloud Console with redirect URI: https://auth.privy.io/api/v1/oauth/callback

# Mock auth for demo: no login required; one click to dashboard; /dashboard never redirects to login
# AUTH_MOCK=true

# Beneficiary credit portal (optional defaults)
# NEXT_PUBLIC_CREDIT_DEFAULT_ORG_ID=   # UUID of organizations.id when applicant has no referral code
# Demo: allow POST /api/credit/mock-auth in production (any email → session). Set false in real prod.
# CREDIT_MOCK_AUTH=true

# Staff /dashboard/credit: mock pool donut + KPI cards + sample allocation rows. Set false when org credit APIs + DB are ready.
# NEXT_PUBLIC_CREDIT_DASHBOARD_MOCK=

# Transactional email (credit review notifications — Resend)
# RESEND_API_KEY=
# CREDIT_EMAIL_FROM=Sozu Credit <notifications@resend.dev>

# SDP operator — server only (Railway-hosted SDP backend)
# URL of the tenant SDP API, e.g. https://mujeres2000.sdp.yourdomain.com or Railway public URL.
# SDP_API_URL=https://sdp-v2-production-f6c7.up.railway.app
# SDP v6 multi-tenant: tenant name sent as header on every request.
# SDP_TENANT_NAME=mujeres-admin
# SDP operator user credentials (NGO staff account created during tenant seed).
# SDP_ADMIN_EMAIL=
# SDP_ADMIN_PASSWORD=
# Base URL of the recipient wallet (used when building registration invite links).
# SOZUCREDIT_URL=https://credit.sozu.capital
# Sender address for SDP invite emails (falls back to CREDIT_EMAIL_FROM).
# SDP_INVITE_EMAIL_FROM=Sozu Credit <invites@resend.dev>

# Salesforce CRM sync (optional — queue in crm_sync_queue)
# SALESFORCE_INSTANCE_URL=https://yourinstance.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_USERNAME=
# SALESFORCE_PASSWORD=
# SALESFORCE_SECURITY_TOKEN=
# SALESFORCE_SOBJECT_CREDIT_APP=Sozu_Credit_Application__c
# SALESFORCE_EXTERNAL_ID_FIELD=Sozu_External_Id__c

# Cron: GET /api/cron/crm-sync?secret=YOUR_SECRET
# CRON_SECRET=

# Local fiat display (store balance screen)
# Set to ISO-4217 code to show "today's value in local currency" alongside USD balance.
# Rates are fetched daily from api.frankfurter.app (free, ECB-sourced). Leave unset for USD-only.
# LOCAL_FIAT_CURRENCY=MXN

# Ramp provider (on-ramp / off-ramp)
# RAMP_PROVIDER=stub          # default; change to "bridge", "circle", etc. when ready
# RAMP_WEBHOOK_SECRET=        # shared secret for verifying inbound webhook signatures
# Bridge.xyz example:
# BRIDGE_API_KEY=
# BRIDGE_API_URL=https://api.bridge.xyz/v0
# Circle example:
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=

# Vault / yield (separate spec – Phase 4)
# VAULT_* as per vault protocol

# Optional: Key derivation / backup (separate security spec)
# KEY_DERIVATION_* – plug-in point per spec §7

# Shadow payment rail POC (internal ledger + manual fiat confirm)
# SHADOW_LEDGER_FX_CLP_PER_USDC=920   # CLP per 1 USDC before spread
# SHADOW_LEDGER_SPREAD_BPS=200        # 200 = 2% worse rate → fewer USDC credited
# SHADOW_PAYMENT_INSTRUCTIONS=        # optional; shown to merchant after create-payment
# SHADOW_LP_STELLAR_PUBLIC_KEY=       # optional; G-address of prefunded LP for admin oracle LP widget
# SHADOW_LP_ALERT_USDC_MIN=500        # optional; admin API sets lowLiquidity when on-chain USDC is below this
